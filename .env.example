NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Set true only when deployed behind a trusted reverse proxy.
TRUST_PROXY=false

# Public POST /api/profile limit per client IP. Defaults: 3 requests per 60 seconds.
PROFILE_RATE_LIMIT_MAX=3
PROFILE_RATE_LIMIT_WINDOW_MS=60000

# Process-wide normalized profile cache. Defaults: 15 minutes, 50 entries.
PROFILE_CACHE_TTL_MS=900000
PROFILE_CACHE_MAX_ENTRIES=50

# Process-wide LinkedIn extraction attempts. Cache hits do not consume this quota.
GLOBAL_EXTRACTION_LIMIT_MAX=6
GLOBAL_EXTRACTION_LIMIT_WINDOW_MS=60000

# Required: copy the two Request Cookie values from your signed-in browser.
# Preserve the quotes around JSESSIONID.
# Example shape only:
# LINKEDIN_COOKIE='li_at=value; JSESSIONID="ajax:value"'
LINKEDIN_COOKIE=

# Required: the inner JSESSIONID value without quotes.
# Example shape only: ajax:value
LINKEDIN_CSRF_TOKEN=

# Optional: defaults to 30 seconds.
LINKEDIN_REQUEST_TIMEOUT_MS=30000
